<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1B2E"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khuyến mãi &amp; Voucher"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voucher của bạn:"
        android:textColor="#8888AA"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerVouchers"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#FFFFFF"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnApplyPromo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Áp dụng Voucher"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#F57C00"/>

    <TextView
        android:id="@+id/tvPromoStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF5252"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>
</LinearLayout>
